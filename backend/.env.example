# Required
DATABASE_URL=postgres://user:pass@host:5432/db      # Railway: ${{Postgres.DATABASE_URL}}
ADMIN_TOKEN=                                         # >= 24 chars. Guards /admin/* (pairing codes, session upload). openssl rand -hex 24
SESSION_ENCRYPTION_KEY=                              # 32 bytes, base64. Encrypts the Railway session at rest. openssl rand -base64 32

# Telegram channel (optional; the channel is skipped when unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Push channel (optional until Firebase is set up). Firebase service-account JSON, either raw or base64.
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_SERVICE_ACCOUNT_JSON=

PORT=3000
