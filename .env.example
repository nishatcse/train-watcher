TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Routes are defined in routes.json (an array of {from,to,date,train,class}).
# routes.json OVERRIDES the single-route vars below. The vars below are only a
# fallback used when routes.json is absent.
JOURNEY_DATE=26-Mar-2026
FROM_CITY=Dhaka
TO_CITIES=Feni,Chattogram
TRAIN_NAME=TURNA (742)
SEAT_CLASS=S_CHAIR

# Seconds between each round-robin check (one route per tick)
POLL_INTERVAL_SECONDS=10

# --- Auto seat-hold (drives the real booking page in Chrome; Turnstile is
#     mandatory on booking, so this cannot be done with plain HTTP) ---
# Master switch. When true, the watcher also polls the HOLD_* target below and
# holds seats there as soon as any become available.
AUTO_HOLD_ENABLED=false
# The train to auto-hold on. Independent of the routes.json the watcher polls.
# All five must be set for holding to work. Use the same city/train/class
# spelling the site uses (e.g. Chattogram, "TURNA (742)", S_CHAIR).
HOLD_FROM=Dhaka
HOLD_TO=Chattogram
HOLD_DATE=27-Jul-2026
HOLD_TRAIN=TURNA (742)
HOLD_CLASS=S_CHAIR
# How many hold cycles to run: hold -> wait -> re-hold, repeated this many times,
# then release. 1 = hold once and release.
HOLD_REPEAT_COUNT=1
# Specific seats to hold, comma-separated (e.g. THO-44,THO-43). When set, these
# exact seats are held (whatever is free is held, the rest reported). Leave empty
# to auto-pick with SEATS_TO_HOLD below.
HOLD_SEATS=
# Seats to auto-pick per trigger when HOLD_SEATS is empty (1-4). Priority:
# adjacent > same coach > any.
SEATS_TO_HOLD=2
# Seconds to wait between re-hold cycles (railway releases a held seat after
# ~4-5 min, so keep this below that to refresh the hold).
HOLD_REFRESH_SECONDS=180

# --- Multi-account seat-hold ROTATION (npm run hold-rotate) ---
# The railway locks an account for ~1 hour after it releases a hold, so one
# account cannot keep the same seats forever. The rotation lets several accounts
# take turns on the SAME seats: each holds for a turn, releases, and sits out its
# lock while the others cover it. With 5 accounts the clock tiles exactly:
#   id-1 2:00-2:15 (locked till 3:15), id-2 2:15-2:30, ... id-5 3:00-3:15,
#   then id-1 again at 3:15.
# Uses the same HOLD_FROM/TO/DATE/TRAIN/CLASS target as above.
HOLD_ROTATION_ENABLED=false
# Turn off the watcher's single-account auto-hold when the rotation is on, so the
# two do not fight over the same seats.
# AUTO_HOLD_ENABLED=false
#
# The coach ("bogie") the seats are in, as the dropdown spells it (e.g. UMA).
# Leave empty to search every coach for the seat numbers below.
HOLD_COACH=
# HOLD_SEATS above is REQUIRED for the rotation — it holds these exact seats and
# never substitutes others. E.g. HOLD_SEATS=UMA-11,UMA-12
#
# One turn = HOLD_CYCLES_PER_TURN x HOLD_CYCLE_SECONDS (3 x 300s = 15 min).
# Within a turn the seats are released+reselected between cycles to refresh the
# railway's own ~5 min hold window.
HOLD_CYCLE_SECONDS=300
HOLD_CYCLES_PER_TURN=3
# How long an account is considered locked after it releases (railway's rule).
HOLD_LOCK_MINUTES=60
HOLD_LOCK_SAFETY_SECONDS=30
# Open the next account's browser this many seconds before the current turn ends,
# so the handover costs a click instead of a full login+search+layout flow.
HOLD_PREWARM_SECONDS=120
# Breather between re-checks when the seats are held by someone OUTSIDE the
# rotation. Not the real cadence: every check costs a seat-layout open (the
# layout API needs a fresh single-use Turnstile token, so nothing lighter is
# possible), which makes the effective cadence ~8-12s.
# A normal handover does not poll at all — the incoming account grabs the seats
# straight after the outgoing one releases them (measured gap: 2-7s).
HOLD_POLL_SECONDS=5
# How often the hunter runs its CHEAP availability probe (search-trips-v2 — no
# Turnstile, ~200ms). This is the real reaction time when a seat frees up: the
# expensive seat-layout open only happens once this probe says something is
# available. Keep it small; it costs almost nothing.
HOLD_HUNT_POLL_SECONDS=3
# What to do with a held seat between cycles:
#   verify  - never let go, just confirm it is still ours (safe, the default)
#   recycle - release + immediately re-select, to refresh the railway's own hold
#             window. Only use this if that window is proven to expire: it
#             exposes the seat every cycle, and a failed re-select loses it.
HOLD_REFRESH_MODE=verify
# false = hold ONLY the seats named in HOLD_SEATS, waiting however long it takes.
# true  = HOLD_SEATS is a preference: if those seats are gone, grab any free ones
#         instead (adjacent in one coach first, so a party sits together).
#         Whatever ends up held becomes the target for the next handover, so the
#         rotation does not churn through new seats every turn.
HOLD_ANY_SEAT=false
# How many seats to hold in total. Defaults to however many HOLD_SEATS names.
# HOLD_SEAT_COUNT=2
# recycle mode only: how long to keep retrying a re-select before giving the
# seat up for lost.
HOLD_REHOLD_RETRY_SECONDS=30
# true = two Chromes alive during the ~2 min handover window (fast, needs RAM).
# false = strictly one Chrome at a time (safe on a 1GB Pi, ~1 min handover gap).
HOLD_OVERLAP=true
# When to stop: the rotation releases the seats and exits cleanly at this time.
HOLD_STOP_AT=31-Jul-2026 06:00


# /usr/bin/chromium-browser on Raspberry Pi
BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# WATCHER account (account A) — used ONLY to monitor seat availability via the
# API. It is never used in the browser, so its session never breaks.
RAILWAY_USERNAME=your_mobile_number
RAILWAY_PASSWORD=your_password

# HOLDER account (account B) — a SECOND railway account used ONLY to hold seats
# in the browser. This is the account that actually holds the seats and that you
# will complete the booking/payment with. Keeping it separate means holding never
# disturbs the watcher account above. Required when AUTO_HOLD_ENABLED=true.
HOLDER_USERNAME=your_second_mobile_number
HOLDER_PASSWORD=your_second_password

# ROTATION accounts — the 5 railway ids that take turns holding the seats
# (HOLD_ROTATION_ENABLED=true). Each gets its own Chrome profile
# (state/holder-profile-N) and CDP port (9231..9235). Log them all in once with
# `npm run holders-login`. If HOLDER_1_* is unset, HOLDER_USERNAME/PASSWORD above
# is used as account 1.
HOLDER_1_USERNAME=
HOLDER_1_PASSWORD=
HOLDER_2_USERNAME=
HOLDER_2_PASSWORD=
HOLDER_3_USERNAME=
HOLDER_3_PASSWORD=
HOLDER_4_USERNAME=
HOLDER_4_PASSWORD=
HOLDER_5_USERNAME=
HOLDER_5_PASSWORD=

# Filled automatically by `npm run relogin` — do not edit by hand
RAILWAY_SESSION_COOKIES=
