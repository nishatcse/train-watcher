TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Routes are defined in routes.json (an array of {from,to,date,train,class}).
# routes.json OVERRIDES the single-route vars below. The vars below are only a
# fallback used when routes.json is absent.
JOURNEY_DATE=26-Mar-2026
FROM_CITY=Dhaka
TO_CITIES=Feni,Chattogram
TRAIN_NAME=TURNA (742)
SEAT_CLASS=S_CHAIR

# Seconds between cycles. Every cycle checks ALL routes (in parallel), not one.
POLL_INTERVAL_SECONDS=10

# How many search requests may be in flight at once, and a random pre-request
# stagger. All of them carry the same device id, so the server sees a single
# device firing N requests: start at 2, watch the logs for HTTP 429, and only
# then raise it. Capped at 10.
SCAN_CONCURRENCY=2
SCAN_JITTER_MS=120

# /usr/bin/chromium-browser on Raspberry Pi
BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# WATCHER account (account A) — used ONLY to monitor seat availability via the
# API. It is never used in the browser, so its session never breaks.
RAILWAY_USERNAME=your_mobile_number
RAILWAY_PASSWORD=your_password

# Filled automatically by `npm run relogin` — do not edit by hand
RAILWAY_SESSION_COOKIES=

# --- BR Explorer live train location (`npm run location -- "TURNA (741)"`) ---
# This is the BR Explorer/SUNCROPS account, not the Shohoz railway ticket account.
BREX_PHONE=your_brex_mobile_number
BREX_UID=your_brex_user_id
BREX_UPASS=your_brex_password_or_api_password
# Optional: copy these from a trusted BR Explorer app session if the API rejects
# the generated defaults.
BREX_DEVICE_ID=
BREX_HW_DEVICE_ID=
BREX_DEVICE_INFO=Node.js train-watcher
BREX_APP_VERSION=1.82.12.0
